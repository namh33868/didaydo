# Public website identity
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Đi Đây Đó
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# PostgreSQL connection string, e.g. postgres://user:password@localhost:5432/diddaydo
DATABASE_URL=postgres://postgres:postgres@localhost:5432/diddaydo

# Admin login. Use a unique password in production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-long-password
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters

# Secret used by the crawler/AI publisher. Send as Authorization: Bearer <key>.
INGEST_API_KEY=replace-this-with-a-different-long-random-key
# true: incoming AI posts publish immediately; false: saved as drafts for review.
INGEST_AUTO_PUBLISH=false

# Optional: number of items displayed on each listing page
POSTS_PER_PAGE=12
